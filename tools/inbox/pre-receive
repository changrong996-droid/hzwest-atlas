#!/bin/bash
# Only refs/heads/agent/<name>/<topic> where <name> is listed in agents.txt; no deletes of others; no main.
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
AG="$ROOT/agents.txt"
Z=0000000000000000000000000000000000000000
while read old new ref; do
  if [[ "$ref" =~ ^refs/heads/agent/([a-z0-9-]{3,24})/[A-Za-z0-9._/-]+$ ]]; then
    name="${BASH_REMATCH[1]}"
    topic="${ref#refs/heads/agent/$name/}"
    if ! grep -qx "$name" "$AG" && [ "$topic" != "join" ]; then
      echo "拒绝：名字 $name 不在名册里。先推送 agent/$name/join 分支，只在 CLAIMS.md「报名」区加一行，等 hark-cr 登记。" >&2; exit 1
    fi
    if [ "$new" != "$Z" ]; then
      # every new commit must carry an Agent: line naming the pusher's branch name
      if [ "$old" = "$Z" ]; then range="$new --not --all"; else range="$old..$new"; fi
      for c in $(git rev-list $range); do
        if ! git log -1 --format=%B "$c" | grep -qx "Agent: $name"; then
          echo "拒绝：提交 ${c:0:8} 缺少末尾一行 'Agent: $name'（见 AGENTS.md 第 2 节）。" >&2; exit 1
        fi
      done
      if git cat-file -e "$new:CLAIMS.md" 2>/dev/null; then
        python3 "$ROOT/claims_gate.py" "$name" main "$new" "$ROOT/claims.lock.json" || exit 1
      fi
      tmp=$(mktemp -d); git archive "$new" | tar -x -C "$tmp"
      if [ -f "$tmp/tools/hz/check_all.js" ]; then
        res=$(cd "$tmp" && timeout 120 node tools/hz/check_all.js 2>&1 | tail -3)
        if ! echo "$res" | grep -q "^OK check_all"; then rm -rf "$tmp"; echo "拒绝：check_all 未通过：" >&2; echo "$res" >&2; exit 1; fi
        echo "check_all 通过：$(echo "$res" | tail -1)" >&2
      fi
      rm -rf "$tmp"
      sz=$(git rev-list --objects $range | git cat-file --batch-check='%(objectsize)' | sort -n | tail -1)
      if [ -n "$sz" ] && [ "$sz" -gt 1048576 ]; then echo "拒绝：有大于 1 MB 的文件。" >&2; exit 1; fi
    fi
  else
    echo "拒绝：只能推送 agent/<名字>/<事项> 分支，不能推 $ref（main 只读）。" >&2; exit 1
  fi
done
exit 0
